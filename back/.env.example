# Base de datos
NODE_ENV=dev
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=omnidesk
DATABASE_USER=postgres
DATABASE_PASSWORD=

# Google AI
GEMINI_API_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública del backend (con ngrok en desarrollo) para el webhook y el back_url
APP_BASE_URL=http://localhost:3000

# Front
FRONTEND_BASE_URL=http://localhost:5173

# Auth / JWT
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_SALT_ROUNDS=10
# En producción con front y back en dominios distintos: secure=true y samesite=none (exige HTTPS)
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Primer administrador; solo se crea si todavía no hay ningún usuario en la base
ADMIN_BOOTSTRAP_EMAIL=admin@omnidesk.local
ADMIN_BOOTSTRAP_PASSWORD=

# Handover a operador humano (US-11)
# Respuestas seguidas del bot sin resolver antes de marcar la conversación para que intervenga
# un operador. El bot sigue contestando: solo se levanta la bandera en el panel.
HANDOVER_FALLBACK_THRESHOLD=3
# Zona horaria con la que se interpretan los horarios de support_hours (la base corre en UTC)
SUPPORT_TIMEZONE=America/Argentina/Buenos_Aires
